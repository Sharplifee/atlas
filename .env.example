# ============================================================================
# Atlas environment — copy to .env.local and fill in. NEVER commit real values.
# ============================================================================

# --- Supabase (create a NEW project; do not reuse another product's) ---------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (A6 agent). Leave empty to keep the agent disabled. -----------
# The agent ALSO requires ATLAS_AGENT_ENABLED=true to run. Default is off.
ANTHROPIC_API_KEY=
ATLAS_AGENT_ENABLED=false
ATLAS_AGENT_MODEL=claude-sonnet-4-6

# --- Cron / automation auth --------------------------------------------------
# Shared secret required by every /api/pull/* and /api/agent/* route.
CRON_SECRET=

# --- Encryption key for tenant ad-platform tokens at rest --------------------
# 32-byte key, base64 encoded. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Meta Marketing API ------------------------------------------------------
# Per-tenant tokens are stored encrypted in the DB, NOT here. These are only
# app-level defaults / replay controls.
META_API_VERSION=v21.0
# fixture | live  — 'fixture' replays local JSON so A2 is testable with no creds
META_MODE=fixture

# --- App ---------------------------------------------------------------------
APP_URL=http://localhost:3000
